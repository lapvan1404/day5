@model IEnumerable<day3.Models.ProductViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form asp-action="Index" method="get" class="mb-3">
    <div class="mb-3">
        <label for="searchString" class="form-label">Search by name:</label>
        <input type="text" id="searchString" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" />
    </div>
    <div class="mb-3">
        <label for="sortOrder" class="form-label">Sort by:</label>
        <select id="sortOrder" name="sortOrder" class="form-select">
            <option value="name" selected="@(ViewData["CurrentSort"]?.ToString() == "name")">Name (A-Z)</option>
            <option value="name_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_desc")">Name (Z-A)</option>
            <option value="price" selected="@(ViewData["CurrentSort"]?.ToString() == "price")">Price (Low to High)</option>
            <option value="price_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "price_desc")">Price (High to Low)</option>
            <option value="category" selected="@(ViewData["CurrentSort"]?.ToString() == "category")">Category (A-Z)</option>
            <option value="category_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "category_desc")">Category (Z-A)</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.CategoryName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    var currentPage = (int)ViewData["PageNumber"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var searchString = ViewData["CurrentSearch"]?.ToString() ?? string.Empty;
    var sortOrder = ViewData["CurrentSort"]?.ToString() ?? string.Empty;
}
<nav aria-label="Product pages">
    <ul class="pagination">
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-searchString="@searchString" asp-route-sortOrder="@sortOrder" asp-route-pageNumber="@(currentPage - 1)">Previous</a>
        </li>
        @for (var pageIndex = 1; pageIndex <= totalPages; pageIndex++)
        {
            <li class="page-item @(pageIndex == currentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-searchString="@searchString" asp-route-sortOrder="@sortOrder" asp-route-pageNumber="@pageIndex">@pageIndex</a>
            </li>
        }
        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-searchString="@searchString" asp-route-sortOrder="@sortOrder" asp-route-pageNumber="@(currentPage + 1)">Next</a>
        </li>
    </ul>
</nav>
